# Copy to .env and edit. docker compose reads .env automatically.
#
# Everything here has a working default, so `docker compose up` runs without
# this file. It exists because the one path that cannot have a portable default
# is where your demos live.

# Where CS2 keeps your demos, on the host. Mounted read-write at /demos inside
# the container, which is the path you enter in the Sync Folder UI.
#
# Windows (default if unset):
DEMO_HOST_DIR=C:/Program Files (x86)/Steam/steamapps/common/Counter-Strike Global Offensive/game/csgo/replays
#
# Linux:
#DEMO_HOST_DIR=${HOME}/.steam/steam/steamapps/common/Counter-Strike Global Offensive/game/csgo/replays
#
# macOS:
#DEMO_HOST_DIR=${HOME}/Library/Application Support/Steam/steamapps/common/Counter-Strike Global Offensive/game/csgo/replays
#
# Or anywhere you keep them:
#DEMO_HOST_DIR=/mnt/storage/cs2-demos


# The Steam Web API key, if you would rather pass it in than store it in
# data/steam_sharecodes.json. Set here it takes precedence over the stored one.
# Get one at https://steamcommunity.com/dev/apikey
#STEAM_API_KEY=
